# Copy to ~/.config/image-search/keys.env and fill in. Environment variables with the same names also work.
# Missing keys only disable that source.

# Google Images via Serper: https://serper.dev (2,500 free queries on sign-up)
SERPER_API_KEY=

# Pixabay: https://pixabay.com/api/docs/ (key is shown there after you log in)
PIXABAY_API_KEY=

# Optional. Exa, used only when `site` mode cannot parse images from a page: https://dashboard.exa.ai
EXA_API_KEY=
